<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>文件导入服务</title>
    <style>
    :root{
      /* ===== 京东风配色 ===== */
      --jd-red:#E1251B;
      --jd-red-dark:#C81623;
      --jd-red-soft:#FFF1F0;
      --bg:#f4f4f4;
      --panel:#ffffff;
      --text:#333333;
      --text-sub:#666666;
      --muted:#999999;
      --border:#e8e8e8;
      --border-strong:#d9d9d9;
      --ok:#2BA471;
      --err:#D9363E;
      --shadow:0 4px 16px rgba(0,0,0,.10);
    }
    *{box-sizing:border-box}
    ::-webkit-scrollbar{width:8px;height:8px}
    ::-webkit-scrollbar-thumb{background:#d9d9d9;border-radius:8px}
    ::-webkit-scrollbar-thumb:hover{background:#bfbfbf}
    ::-webkit-scrollbar-track{background:transparent}

    body{
      font-family:"Microsoft YaHei","PingFang SC","Segoe UI",system-ui,-apple-system,Arial,sans-serif;
      background-color:var(--bg);
      color:var(--text);
      margin:0;
      padding:20px;
      display:flex;
      justify-content:center;
    }
    .container{
      width:100%;
      max-width:840px;
      background-color:var(--panel);
      border:1px solid var(--border);
      border-top:3px solid var(--jd-red);
      border-radius:8px;
      padding:0 26px 26px;
      box-shadow:var(--shadow);
      height:fit-content;
    }

    /* 页面头部（京东式：红方块 logo + 标题） */
    .page-head{
      display:flex;
      align-items:center;
      gap:12px;
      padding:18px 0 16px;
      border-bottom:1px solid var(--border);
      margin-bottom:20px;
    }
    .logo{
      width:60px;height:38px;border-radius:4px;
      background:linear-gradient(180deg,#F0402F,#E1251B);
      display:flex;align-items:center;justify-content:center;
      font-size:19px;color:#fff;font-weight:500;
      letter-spacing:1px;flex:0 0 auto;
    }
    .page-title{display:flex;flex-direction:column;line-height:1.2}
    .page-title strong{font-size:16px;font-weight:500;color:var(--text)}
    .page-title span{font-size:12px;color:var(--muted);margin-top:4px}

    /* 上传区 */
    .upload-area{
      border:1px dashed var(--border-strong);
      border-radius:8px;
      padding:40px 20px;
      text-align:center;
      cursor:pointer;
      transition:all .25s;
      background:#fff;
    }
    .upload-area:hover{
      border-color:var(--jd-red);
      background-color:var(--jd-red-soft);
    }
    .upload-area p{margin:0;font-size:14.5px;font-weight:500;color:var(--text)}
    .upload-icon{
      font-size:44px;
      margin-bottom:10px;
      line-height:1;
    }
    .upload-hint{
      font-size:12px;
      color:var(--muted);
      margin-top:8px;
    }
    .file-input{display:none}
    .btn{
      background:linear-gradient(90deg,#F0402F,#E1251B);
      color:#fff;
      border:none;
      padding:10px 20px;
      border-radius:4px;
      cursor:pointer;
      font-size:15px;
      font-family:inherit;
      font-weight:500;
      transition:background .2s;
    }
    .btn:hover{background:linear-gradient(90deg,#E1251B,#C81623)}
    .btn:disabled{background:#d9d9d9;cursor:not-allowed}

    /* 文件列表 */
    .file-list{margin-top:20px}
    .file-item{
      background-color:#fff;
      border:1px solid var(--border);
      border-radius:4px;
      padding:15px;
      margin-bottom:10px;
      display:flex;
      justify-content:space-between;
      align-items:center;
      animation:fadeIn .3s ease;
    }
    @keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
    .file-info{
      display:flex;
      flex-direction:column;
      flex:1;
      margin-right:20px;
      min-width:0;
    }
    .file-name{
      font-weight:500;
      color:var(--text);
      font-size:13.5px;
      overflow:hidden;
      text-overflow:ellipsis;
      white-space:nowrap;
    }
    .file-size{
      font-size:12px;
      color:var(--muted);
      margin-top:4px;
    }
    .status-badge{
      padding:6px 13px;
      border-radius:2px;
      font-size:12px;
      font-weight:500;
      color:#fff;
      min-width:80px;
      text-align:center;
      flex:0 0 auto;
    }
    .status-uploading{background-color:#FFA940}
    .status-processing{background-color:#E1251B}
    .status-completed{background-color:#2BA471}
    .status-error{background-color:#fff;border:1px solid var(--err);color:var(--err)}

    /* 进度条 */
    .progress-bar-container{
      width:100%;
      height:5px;
      background-color:#f0f0f0;
      margin-top:9px;
      border-radius:2px;
      overflow:hidden;
      display:none;
    }
    .progress-bar{
      height:100%;
      background:linear-gradient(90deg,#F0402F,#E1251B);
      width:0%;
      border-radius:2px;
      transition:width .3s,background-color .3s;
    }

    /* 任务日志（可展开/收起） */
    .log-details{
      margin-top:8px;
      font-size:12px;
      color:var(--muted);
    }
    .log-details summary{
      cursor:pointer;
      user-select:none;
      color:var(--text-sub);
      font-weight:500;
    }
    .log-list{
      margin:6px 0 0 16px;
      padding:0;
    }
    .log-list li{
      margin:2px 0;
      line-height:1.5;
    }

    /* 窄屏适配 */
    @media (max-width:760px){
      body{padding:0}
      .container{max-width:none;border-radius:0;border-left:none;border-right:none;padding:0 16px 20px}
      .upload-area{padding:28px 14px}
      .file-item{flex-direction:column;align-items:flex-start;gap:10px}
      .file-info{margin-right:0;width:100%}
    }
  </style>
</head>
<body>

<div class="container">
    <div class="page-head">
        <div class="logo">度</div>
        <div class="page-title">
            <strong>小度小度 · 知识库导入</strong>
            <span>上传 PDF / Markdown，自动解析、切片并入库</span>
        </div>
    </div>

    <div class="upload-area" id="dropZone" onclick="document.getElementById('fileInput').click()">
        <div class="upload-icon">☁️</div>
        <p>点击或拖拽文件到此处上传</p>
        <div class="upload-hint">支持批量上传 · PDF / Markdown</div>
        <input type="file" id="fileInput" class="file-input" multiple accept=".pdf,.md">
    </div>

    <div id="fileList" class="file-list">
        <!-- 文件列表将在这里生成 -->
    </div>
</div>

<script>
    const dropZone = document.getElementById('dropZone');
    const fileInput = document.getElementById('fileInput');
    const fileList = document.getElementById('fileList');
    
    // 模拟后端API地址
    const API_BASE = 'http://127.0.0.1:8002';

    function highlightDropZone(on) {
        dropZone.style.backgroundColor = on ? '#FFF1F0' : '';
        dropZone.style.borderColor = on ? '#E1251B' : '';
    }

    dropZone.addEventListener('dragover', (e) => {
        e.preventDefault();
        highlightDropZone(true);
    });

    dropZone.addEventListener('dragleave', (e) => {
        e.preventDefault();
        highlightDropZone(false);
    });

    dropZone.addEventListener('drop', (e) => {
        e.preventDefault();
        highlightDropZone(false);
        handleFiles(e.dataTransfer.files);
    });

    fileInput.addEventListener('change', (e) => {
        handleFiles(e.target.files);
    });

    function handleFiles(files) {
        Array.from(files).forEach(uploadFile);
    }

    function updateProgressBar(bar, percentage) {
        bar.style.width = percentage + '%';
        if (percentage >= 100) {
            bar.style.backgroundColor = '#3498db'; // 蓝色
        } else {
            bar.style.backgroundColor = '#f39c12'; // 橘红色
        }
    }

    async function uploadFile(file) {
        // 创建文件项UI
        const id = 'file-' + Math.random().toString(36).substr(2, 9);
        const html = `
            <div class="file-item" id="${id}">
                <div class="file-info">
                    <span class="file-name">${file.name}</span>
                    <span class="file-size">${(file.size / 1024).toFixed(2)} KB</span>
                    <div class="progress-bar-container">
                        <div class="progress-bar"></div>
                    </div>
                    <details class="log-details">
                        <summary>日志（点击展开）</summary>
                        <ul class="log-list"></ul>
                    </details>
                </div>
                <div class="status-badge status-uploading">上传中...</div>
            </div>
        `;
        fileList.insertAdjacentHTML('afterbegin', html);
        const itemEl = document.getElementById(id);
        const statusBadge = itemEl.querySelector('.status-badge');
        const progressBar = itemEl.querySelector('.progress-bar');
        const progressContainer = itemEl.querySelector('.progress-bar-container');
        const logDetails = itemEl.querySelector('.log-details');
        const logSummary = itemEl.querySelector('.log-details summary');
        const logListEl = itemEl.querySelector('.log-list');

        // 构建FormData
        const formData = new FormData();
        formData.append('files', file);

        try {
            // 1. 上传文件
            progressContainer.style.display = 'block';
            // 模拟上传进度
            updateProgressBar(progressBar, 50);

            const response = await fetch(`${API_BASE}/upload`, {
                method: 'POST',
                body: formData
            });

            if (!response.ok) throw new Error('Upload failed');
            
            const result = await response.json();
            const taskId = result.task_ids[0]; // 假设一次传一个或取第一个

            // 上传完成，进入处理中，进度固定为30%
            updateProgressBar(progressBar, 30);
            statusBadge.textContent = '处理中...';
            statusBadge.className = 'status-badge status-processing';

            // 2. 轮询状态
            pollStatus(taskId, itemEl);

        } catch (error) {
            console.error(error);
            statusBadge.textContent = '失败';
            statusBadge.className = 'status-badge status-error';
        }
    }

    function normalizeDoneLog(text) {
        // 后端可能返回中文节点名，也可能已拼接“已完成”
        if (typeof text !== 'string') return String(text);
        return text.endsWith('已完成') ? text : `${text}已完成`;
    }

    function normalizeRunningLog(text) {
        // 后端可能返回中文节点名，也可能已拼接“正在进行.../处理中...”
        if (typeof text !== 'string') return String(text);
        if (text.startsWith('正在进行')) return text.endsWith('...') ? text : `${text}...`;
        return `正在进行${text}...`;
    }

    function renderLogs(itemEl, doneList, runningList) {
        const logSummary = itemEl.querySelector('.log-details summary');
        const logListEl = itemEl.querySelector('.log-list');
        const logDetails = itemEl.querySelector('.log-details');

        const done = Array.isArray(doneList) ? doneList : [];
        const running = Array.isArray(runningList) ? runningList : [];

        // 更新 summary（即使收起也能看到进度）
        logSummary.textContent = `日志（已完成${done.length}，进行中${running.length}，点击展开）`;

        // 清空并重建列表
        logListEl.innerHTML = '';
        const lines = [
            ...done.map(normalizeDoneLog),
            ...running.map(normalizeRunningLog),
        ];

        if (lines.length === 0) {
            const li = document.createElement('li');
            li.textContent = '暂无日志';
            logListEl.appendChild(li);
        } else {
            for (const line of lines) {
                const li = document.createElement('li');
                li.textContent = line;
                logListEl.appendChild(li);
            }
        }

        // 如果没有任何日志，默认收起；否则保持用户选择
        if (lines.length === 0) {
            logDetails.open = false;
        }
    }

    function pollStatus(taskId, itemEl) {
        const statusBadge = itemEl.querySelector('.status-badge');
        const progressBar = itemEl.querySelector('.progress-bar');
        
        const interval = setInterval(async () => {
            try {
                const res = await fetch(`${API_BASE}/status/${taskId}`);
                const data = await res.json();

                // 渲染日志（done/running）
                renderLogs(itemEl, data.done_list, data.running_list);
                
                if (data.status === 'completed') {
                    statusBadge.textContent = '已完成';
                    statusBadge.className = 'status-badge status-completed';
                    updateProgressBar(progressBar, 100);
                    clearInterval(interval);
                } else if (data.status === 'processing') {
                    // 保持处理中状态
                    statusBadge.textContent = '处理中...';
                    // 确保进度为30%
                     updateProgressBar(progressBar, 30);
                } else if (data.status === 'failed') {
                    statusBadge.textContent = '失败';
                    statusBadge.className = 'status-badge status-error';
                    clearInterval(interval);
                }
            } catch (e) {
                console.error('Polling error', e);
            }
        }, 2000); // 每2秒轮询一次
    }
</script>

</body>
</html>
